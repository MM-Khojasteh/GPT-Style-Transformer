# ============================================================================
# GPT-Style-Transformer — Environment Configuration Template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in every value:
#
#     cp .env.example .env
#
# `.env` is GIT-IGNORED by design. It holds this project's working
# configuration matrix (paths, hyperparameters, thresholds, toggles) and must
# never be committed. Entry-point scripts refuse to run without it.
#
# CLI flags override these values (e.g. `--epochs 20` beats TRAIN_EPOCHS).
# ============================================================================

# ----------------------------------------------------------------------------
# Data paths (private corpora — never committed; see data/README.md)
# ----------------------------------------------------------------------------
# Training corpus used to fit the tokenizer and train the model
TRAIN_DATA_PATH=
# Corpus used to rebuild the character vocabulary at generation time
TOKENIZER_CORPUS_PATH=
# Fine-tuning corpus (typically smaller / domain-specific)
FINETUNE_DATA_PATH=

# ----------------------------------------------------------------------------
# Checkpoints (model weights are git-ignored binaries; see checkpoints/README.md)
# ----------------------------------------------------------------------------
# Trained weights loaded for generation, fine-tuning, and evaluation
CHECKPOINT_PATH=
# Where new checkpoints are written during training
CHECKPOINT_DIR=
# Where fine-tuning checkpoints are written
FINETUNE_CHECKPOINT_DIR=

# ----------------------------------------------------------------------------
# Training hyperparameters
# ----------------------------------------------------------------------------
# Epochs for examples/train_model.py
TRAIN_EPOCHS=
# Epochs for the memory-optimized runner (optimized_training_config.py)
OPT_TRAIN_EPOCHS=
# Epochs for examples/fine_tune.py
FINETUNE_EPOCHS=
# AdamW peak learning rate for pretraining (e.g. 0.0003)
TRAIN_LEARNING_RATE=
# AdamW peak learning rate for fine-tuning (typically far lower)
FINETUNE_LEARNING_RATE=
# Decoupled weight decay (e.g. 0.1)
TRAIN_WEIGHT_DECAY=
# Fraction of total optimizer steps used for LR warmup, 0-1 (e.g. 0.1)
TRAIN_WARMUP_FRACTION=
# Validation split ratio (0.0 disables)
TRAIN_VAL_SPLIT=
# Test split ratio (0.0 disables)
TRAIN_TEST_SPLIT=
# Gradient clipping threshold (e.g. 1.0)
TRAIN_MAX_GRAD_NORM=
# Reproducibility seed (Python / PyTorch / CUDA)
TRAIN_RANDOM_SEED=

# ----------------------------------------------------------------------------
# Checkpointing & logging cadence (in optimizer steps)
# ----------------------------------------------------------------------------
TRAIN_CHECKPOINT_INTERVAL=
OPT_CHECKPOINT_INTERVAL=
FINETUNE_CHECKPOINT_INTERVAL=
LOG_INTERVAL=

# ----------------------------------------------------------------------------
# Engineering toggles (true | false)
# ----------------------------------------------------------------------------
# Mixed-precision (AMP) training
TRAIN_USE_AMP=
# TensorBoard logging
USE_TENSORBOARD=
# Weights & Biases logging
USE_WANDB=

# ----------------------------------------------------------------------------
# Text generation (sampling thresholds)
# ----------------------------------------------------------------------------
GEN_MAX_NEW_TOKENS=
# Sampling temperature (0 = greedy decoding)
GEN_TEMPERATURE=
# Top-k filtering (0 disables)
GEN_TOP_K=
# Nucleus (top-p) filtering (1.0 disables)
GEN_TOP_P=

# ----------------------------------------------------------------------------
# Optional: Weights & Biases (only used when USE_WANDB=true)
# ----------------------------------------------------------------------------
WANDB_API_KEY=
WANDB_PROJECT=
# offline | online | disabled
WANDB_MODE=

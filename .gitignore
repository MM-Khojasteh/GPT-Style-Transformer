# ============================================================================
# GPT-Style-Transformer — strict .gitignore (least-privilege policy)
#
# Policy: ONLY source code, tests, notebooks, documentation, and explicitly
# whitelisted project files may be tracked. Everything else — secrets, data,
# model artifacts, caches, logs, IDE state — is denied by default.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SECRETS & CREDENTIALS (highest priority — never commit these)
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
.envrc
.direnv/
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.kube/config
credentials*
*credential*
secrets.*
*.secret
.kaggle/
kaggle.json
.ngrok2/

# ----------------------------------------------------------------------------
# 2. PYTHON — bytecode, caches, test & packaging artifacts
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
/build/
/dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
share/python-wheels/
/wheels/
*.egg
MANIFEST
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.ipynb_checkpoints/
/.cache/

# ----------------------------------------------------------------------------
# 3. VIRTUAL ENVIRONMENTS & PACKAGE MANAGERS
# ----------------------------------------------------------------------------
.venv/
/venv/
/env/
ENV/
.conda/
.python-version
pip-log.txt
pip-delete-this-directory.txt

# ----------------------------------------------------------------------------
# 4. MODEL ARTIFACTS & TRAINING OUTPUT (large binaries / trained IP)
# ----------------------------------------------------------------------------
checkpoints/*
!checkpoints/README.md
checkpoints_finetuned/
/models/
/outputs/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.pb
*.tflite
*.h5
*.hdf5
*.pkl
*.pickle
*.msgpack
*.gguf
*.npy
*.npz
*.sqlite
*.sqlite3
*.db
# Evaluation report written by comprehensive_evaluation.py --output <file>
/evaluation_results*.json
# To publish curated results later, re-include explicitly, e.g.:
# !docs/results/*.json

# ----------------------------------------------------------------------------
# 5. DATA (training corpora are private — never committed)
# ----------------------------------------------------------------------------
data/*
!data/README.md
*.csv
*.tsv
*.parquet
*.jsonl
/datasets/

# ----------------------------------------------------------------------------
# PRIVATE WORKING NOTES (internal reviews & summaries — never published)
# ----------------------------------------------------------------------------
/notes/

# ----------------------------------------------------------------------------
# 6. EXPERIMENT TRACKING & LOGS
#   (*.tfevents.* also catches stray event files that embed hostnames)
# ----------------------------------------------------------------------------
/runs/
*.tfevents.*
/wandb/
/lightning_logs/
/mlruns/
/logs/
*.log
*.out
*.err

# ----------------------------------------------------------------------------
# 7. JUPYTER / IPYTHON local state
# ----------------------------------------------------------------------------
.ipython/
.jupyter/

# ----------------------------------------------------------------------------
# 8. IDE & EDITOR STATE
# ----------------------------------------------------------------------------
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~
.claude/
.cursor/
.continue/
.history/
.aider*
.windsurf/
.codex/

# ----------------------------------------------------------------------------
# 9. OS-GENERATED FILES
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db
*.lnk
*.stackdump
core
core.*

# ----------------------------------------------------------------------------
# 10. ARCHIVES, MEDIA & TEMPORARY FILES
# ----------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.pdf
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
# To ship diagrams later, re-include them explicitly, e.g.:
# !docs/**/*.png
